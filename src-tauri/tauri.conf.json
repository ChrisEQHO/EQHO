{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EQHO Player",
  "version": "1.0.1",
  "identifier": "com.eqhoplayer.desktop",
  "build": {
    "frontendDist": "desktop-dist",
    "devUrl": "https://www.eqho-player.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Music",
    "shortDescription": "EQHO Player",
    "longDescription": "EQHO Player desktop application.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
