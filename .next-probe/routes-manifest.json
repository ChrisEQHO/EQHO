      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "eqho-player.com"
        }
      ],
      "destination": "https://www.eqho-player.com/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
